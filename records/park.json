  "faq": [
    {
      "id": "19025",
      "park": "misa",
      "activities": [
        "bike"
      ],
      "title": "자전거 매표는 언제 끝나나요?",
      "body": "대여권은 운영 종료 한 시간 전까지 판매합니다. 날짜별 변경 공지가 있으면 공지를 먼저 확인하세요.",
      "original": "미사경정공원에서 자전거 타려고 하는데 몇 시까지 가야 하나요",
      "category": "미사경정공원",
      "registered": "2024-07-09",
      "source": "faq",
      "dataset": "15089962"
    },
    {
      "id": "18992",
      "park": "misa",
      "activities": [
        "bike",
        "walk"
      ],
      "title": "공원 입장료가 있나요?",
      "body": "미사경정공원은 입장료가 없습니다. 차를 가져가면 주차요금을 따로 냅니다.",
      "original": "미사경정공원 입장료는 있나요",
      "category": "미사경정공원",
      "registered": "2024-07-09",
      "source": "faq",
      "dataset": "15089962"
    },
    {
      "id": "18994",
      "park": "misa",
      "activities": [
        "walk"
      ],
      "title": "잔디밭에 돗자리를 펴도 되나요?",
      "body": "나무 그늘에 돗자리를 펼 수 있습니다. 잔디에 기둥을 박는 텐트와 그늘막은 설치할 수 없습니다.",
      "original": "미사경정공원 잔디밭에 텐트를 쳐도 되나요",
      "category": "미사경정공원",
      "registered": "2024-07-09",
      "source": "faq",
      "dataset": "15089962"
    },
    {
      "id": "19027",
      "park": "misa",
      "activities": [
        "walk"
      ],
      "title": "아이들과 소풍을 가려면 예약해야 하나요?",
      "body": "일반 소풍은 장소를 예약할 필요가 없습니다. 단체 체육행사로 운동장을 쓰려면 시설 대관을 신청하세요.",
      "original": "유치원에서 약 20명의 아이들을 데리고 소풍을 가려고 하는데 예약을 해야 하나요",
      "category": "미사경정공원",
      "registered": "2024-07-09",
      "source": "faq",
      "dataset": "15089962"
    },
    {
      "id": "18989",
      "park": "olympic",
      "activities": [
        "show",
        "walk"
      ],
      "title": "어느 지하철역에서 내리나요?",
      "body": "5호선과 9호선 올림픽공원역 3번 출구, 8호선 몽촌토성역 1번 출구에서 공원으로 갈 수 있습니다.",
      "original": "올림픽공원 이용시 대중교통을 알고 싶습니다",
      "category": "한국체육산업개발",
      "registered": "2024-07-09",
      "source": "faq",
      "dataset": "15089962"
    },
    {
      "id": "19021",
      "park": "olympic",
      "activities": [
        "show"
      ],
      "title": "공연장 가까운 주차장은 어디인가요?",
      "body": "공식 교통 및 주차 안내에서 보러 갈 공연장의 위치와 가까운 주차장을 찾을 수 있습니다.",
      "original": "주차 후 공연장까지 오는 방법은 어떻게 되나요",
      "category": "한국체육산업개발",
      "registered": "2024-07-09",
      "source": "faq",
      "dataset": "15089962"
    },
    {
      "id": "18987",
      "park": "olympic",
      "activities": [
        "show"
      ],
      "title": "공연 뒤 물건을 잃어버렸다면?",
      "body": "올림픽공원 홈페이지 유실물센터에서 찾거나 평화의광장과 만남의광장 안내센터에 문의하세요.",
      "original": "공연을 관람 후 소지품을 분실하였을 경우",
      "category": "한국체육산업개발",
      "registered": "2024-07-09",
      "source": "faq",
      "dataset": "15089962"
    },
    {
      "id": "18984",
      "park": "olympic",
      "activities": [
        "walk"
      ],
      "title": "토성 산책로에 자전거가 다니나요?",
      "body": "몽촌토성 안쪽 산책로는 자전거와 인라인 통행을 제한합니다.",
      "original": "올림픽공원내 자전거 이용에 대하여",
      "category": "올림픽공원",
      "registered": "2024-07-09",
      "source": "faq",
      "dataset": "15089962"
    },
    {
      "id": "18998",
      "park": "olympic",
      "activities": [
        "walk"
      ],
      "title": "야외 화장실은 어디서 찾나요?",
      "body": "평화의광장, 만남의광장, 몽촌토성, 체육관 주변에 있습니다. 출입구 초소에서 안내도를 받을 수 있습니다.",
      "original": "공원 내 화장실은 어디 있습니까",
      "category": "한국체육산업개발",
      "registered": "2022-09-15",
